{
    "name": "backend",
    "version": "1.0.0",
    "description": "dự án điểm danh bằng face_id",
    "main": "app.js",
    "scripts": {
        "start": "nodemon",
        "start:server": "nodemon --watch src --ext ts,tsx --exec \"ts-node -r tsconfig-paths/register ./src/app.ts\"",
        "dev": "npm run start:server",
        "test": "echo \"Error: no test specified\" && exit 1",
        "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/app.ts"
    },
    "nodemonConfig": {
        "watch": [
            "src"
        ],
        "ext": "ts",
        "ignore": [
            "node_modules"
        ],
        "exec": "ts-node -r tsconfig-paths/register ./src/app.ts"
    },
    "keywords": [
        "nodejs",
        "with",
        "typescript"
    ],
    "author": "danh",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "6.3.0",
        "@types/nodemailer": "^6.4.17",
        "bcrypt": "^5.1.1",
        "cors": "2.8.5",
        "dotenv": "16.4.7",
        "express": "5.0.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^7.0.5",
        "passport": "0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "uuid": "11.0.5",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/express": "5.0.0",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/multer": "1.4.12",
        "@types/node": "22.10.7",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "nodemon": "^3.1.9",
        "prisma": "6.3.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "5.7.3"
    }
}
